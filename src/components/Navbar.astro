---
const navLinks = [
  { name: 'Join Our Community', href: '/#community' },
  { name: 'Features', href: '/#features' },
  { name: 'About Us', href: '/#about' },
  { name: 'Demo', href: '/#demo' },
  { name: 'Contact Us', href: '/#contact' },
];
---

<nav class="bg-white shadow-md fixed w-full top-0 z-50 animate-slide-down">
  <div class="section-container">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo: SangRoot with blood drop 'o's -->
      <a href="/" class="flex items-center space-x-2 group">
        <!-- Medical blood drop icon with cross -->
        <div class="w-8 h-8 md:w-10 md:h-10 bg-primary-500 rounded-lg flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 animate-bounce-in relative overflow-hidden">
          <svg class="w-5 h-5 md:w-6 md:h-6 text-white relative z-10" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.5c-3.5 0-6.5 3-6.5 6.5 0 4 6.5 11 6.5 11s6.5-7 6.5-11c0-3.5-3-6.5-6.5-6.5z" />
            <rect x="10" y="7" width="4" height="8" fill="white" />
            <rect x="7" y="10" width="10" height="4" fill="white" />
          </svg>
          <svg class="absolute bottom-1 w-6 h-2 md:w-8 md:h-2 text-white opacity-30" viewBox="0 0 40 10">
            <path d="M0,5 L8,5 L12,1 L16,9 L20,5 L28,5 L32,1 L36,9 L40,5" stroke="white" stroke-width="1.5" fill="none" class="animate-pulse" />
          </svg>
        </div>
        
        <!-- SangRoot text with blood drop 'o's facing downward -->
        <span class="text-lg md:text-2xl font-heading font-bold text-gray-900 group-hover:text-primary-500 transition-colors duration-300 flex items-center">
          <span>Sang</span>
          <span class="text-primary-500 flex items-center">
            <!-- R (first letter) -->
            <span>R</span>
            
            <!-- First 'o' transformed into downward-facing blood drop -->
            <span class="relative inline-flex items-center justify-center mx-[-2px]">
              <svg class="w-4 h-4 md:w-5 md:h-5 text-primary-500 transform rotate-180" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.5c-3.5 0-6.5 3-6.5 6.5 0 4 6.5 11 6.5 11s6.5-7 6.5-11c0-3.5-3-6.5-6.5-6.5z" />
              </svg>
              <span class="sr-only">o</span>
            </span>
            
            <!-- Second 'o' transformed into downward-facing blood drop -->
            <span class="relative inline-flex items-center justify-center mx-[-2px]">
              <svg class="w-4 h-4 md:w-5 md:h-5 text-primary-500 transform rotate-180" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.5c-3.5 0-6.5 3-6.5 6.5 0 4 6.5 11 6.5 11s6.5-7 6.5-11c0-3.5-3-6.5-6.5-6.5z" />
              </svg>
              <span class="sr-only">o</span>
            </span>
            
            <!-- t (last letter) -->
            <span>t</span>
          </span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {navLinks.map((link, index) => (
          <a 
            key={index}
            href={link.href} 
            class={`text-sm lg:text-base text-gray-700 hover:text-primary-500 font-medium transition-all duration-200 hover:scale-110 animate-fade-in animation-delay-${(index + 2) * 100} whitespace-nowrap`}
          >
            {link.name}
          </a>
        ))}
        <a href="/registerDonor" class="btn-primary text-sm lg:text-base hover:scale-105 active:scale-95 transition-transform duration-200 animate-pulse-glow-border animate-fade-in animation-delay-600 whitespace-nowrap">
          Donate Blood
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-button" 
        class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors group"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6 text-gray-700 group-hover:scale-110 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
    <div class="section-container py-4 space-y-3">
      {navLinks.map((link, index) => (
        <a 
          key={index}
          href={link.href} 
          class="block py-2 text-sm text-gray-700 hover:text-primary-500 font-medium transition-all duration-200 hover:translate-x-2 hover:scale-105"
        >
          {link.name}
        </a>
      ))}
      <a href="/registerDonor" class="block btn-primary text-center text-sm hover:scale-105 active:scale-95 transition-transform duration-200">
        Donate Blood
      </a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle with animation
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      setTimeout(() => {
        mobileMenu?.classList.add('animate-slide-down-mobile');
      }, 10);
    } else {
      mobileMenu?.classList.remove('animate-slide-down-mobile');
      setTimeout(() => {
        mobileMenu?.classList.add('hidden');
      }, 300);
    }
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('animate-slide-down-mobile');
      setTimeout(() => {
        mobileMenu?.classList.add('hidden');
      }, 300);
    });
  });

  // Navigation handler for hash links
  document.querySelectorAll('a[href^="/#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      
      if (window.location.pathname === '/') {
        const targetId = href?.replace('/#', '#');
        const target = document.querySelector(targetId);
        if (target) {
          const offset = 80;
          const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      } else {
        window.location.href = href;
      }
    });
  });

  // Handle initial load with hash
  if (window.location.pathname === '/' && window.location.hash) {
    setTimeout(() => {
      const target = document.querySelector(window.location.hash);
      if (target) {
        const offset = 80;
        const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    }, 100);
  }

  // Add scroll effect to navbar
  let lastScroll = 0;
  const navbar = document.querySelector('nav');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll <= 0) {
      navbar?.classList.remove('shadow-lg');
      navbar?.classList.add('shadow-md');
    } else {
      navbar?.classList.remove('shadow-md');
      navbar?.classList.add('shadow-lg');
    }

    if (currentScroll > lastScroll && currentScroll > 100) {
      navbar?.classList.add('-translate-y-full');
    } else {
      navbar?.classList.remove('-translate-y-full');
    }

    lastScroll = currentScroll;
  });
</script>

<style is:global>
  nav {
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideDownMobile {
    from {
      opacity: 0;
      max-height: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      max-height: 500px;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes bounceIn {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
    70% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes pulseGlowBorder {
    0%, 100% {
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.3);
    }
    50% {
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.5);
    }
  }

  .animate-slide-down {
    animation: slideDown 0.5s ease-out forwards;
  }

  .animate-slide-down-mobile {
    animation: slideDownMobile 0.3s ease-out forwards;
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .animate-bounce-in {
    animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  }

  .animate-pulse-glow-border {
    animation: pulseGlowBorder 2s ease-in-out infinite;
  }

  .delay-150 {
    animation-delay: 150ms;
  }

  .animation-delay-100 {
    animation-delay: 0.1s;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-300 {
    animation-delay: 0.3s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-500 {
    animation-delay: 0.5s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  /* Better touch targets for mobile */
  @media (max-width: 768px) {
    .section-container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    
    nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>