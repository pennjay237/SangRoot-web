---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Form options
const bloodTypes = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
const genders = ['Male', 'Female', 'Other', 'Prefer not to say'];
const regions = [
  'Adamawa',
  'Centre',
  'East',
  'Far North',
  'Littoral',
  'North',
  'Northwest',
  'South',
  'Southwest',
  'West',
];
---

<Layout title="SangRoot - Register as Blood Donor">
  <Navbar />
  
  <main class="bg-[#f5f3ff] min-h-screen py-12 md:py-20 lg:py-28 px-4 sm:px-6">
    <!-- Hero Section -->
    <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16 animate-fade-in-down">
      <div class="inline-block bg-orange-500/10 p-3 rounded-full mb-4 animate-bounce-in">
        <svg class="w-12 h-12 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"/>
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        Become a <span class="text-orange-500">Blood Donor</span>
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto">
        Join our network of life-savers. Your donation can save up to three lives. 
        Register today and be the reason someone gets a second chance.
      </p>
    </div>

    <!-- Stats Section -->
    <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 md:mb-16 animate-fade-in-up animation-delay-200">
      <div class="bg-white rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 hover:scale-105 transform transition-transform">
        <div class="text-3xl font-bold text-orange-500">1M+</div>
        <div class="text-sm text-gray-600">Lives Saved</div>
      </div>
      <div class="bg-white rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 hover:scale-105 transform transition-transform">
        <div class="text-3xl font-bold text-orange-500">50K+</div>
        <div class="text-sm text-gray-600">Active Donors</div>
      </div>
      <div class="bg-white rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 hover:scale-105 transform transition-transform">
        <div class="text-3xl font-bold text-orange-500">200+</div>
        <div class="text-sm text-gray-600">Hospitals</div>
      </div>
      <div class="bg-white rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 hover:scale-105 transform transition-transform">
        <div class="text-3xl font-bold text-orange-500">5min</div>
        <div class="text-sm text-gray-600">Registration</div>
      </div>
    </div>

    <!-- Registration Form -->
    <div class="max-w-3xl mx-auto bg-white rounded-2xl md:rounded-3xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow duration-500 animate-fade-in-up animation-delay-400">
      <!-- Form Header - Changed to orange gradient -->
      <div class="bg-gradient-to-r from-orange-500 to-orange-400 px-6 md:px-8 py-6">
        <h2 class="text-2xl md:text-3xl font-bold text-white">Donor Registration Form</h2>
        <p class="text-white/90 text-sm md:text-base mt-2">Fill in your details to become a registered blood donor</p>
      </div>

      <!-- Form Body -->
      <form class="p-6 md:p-8 space-y-6" id="donorRegistrationForm">
        <!-- Personal Information -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-gray-800 border-b border-gray-200 pb-2">Personal Information</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="fullName">Full Name *</label>
              <input 
                type="text" 
                id="fullName" 
                name="fullName"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                placeholder="Enter your full name"
                required
              />
            </div>
            
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="email">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                placeholder="you@example.com"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="phone">Phone Number *</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                placeholder="6XXXXXXXX"
                required
              />
            </div>
            
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="dob">Date of Birth *</label>
              <input 
                type="date" 
                id="dob" 
                name="dob"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="gender">Gender *</label>
              <select 
                id="gender" 
                name="gender"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                required
              >
                <option value="">Select gender</option>
                {genders.map(gender => (
                  <option value={gender}>{gender}</option>
                ))}
              </select>
            </div>
            
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="bloodType">Blood Type *</label>
              <select 
                id="bloodType" 
                name="bloodType"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                required
              >
                <option value="">Select blood type</option>
                {bloodTypes.map(type => (
                  <option value={type}>{type}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- Location Information -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-gray-800 border-b border-gray-200 pb-2">Location Information</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="region">Region *</label>
              <select 
                id="region" 
                name="region"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                required
              >
                <option value="">Select region</option>
                {regions.map(region => (
                  <option value={region}>{region}</option>
                ))}
              </select>
            </div>
            
            <div class="space-y-2">
              <label class="text-sm font-medium text-gray-700" for="city">City/Town *</label>
              <input 
                type="text" 
                id="city" 
                name="city"
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
                placeholder="Enter your city"
                required
              />
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700" for="address">Address</label>
            <input 
              type="text" 
              id="address" 
              name="address"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
              placeholder="Street address or landmark"
            />
          </div>
        </div>

        <!-- Medical Information -->
        <div class="space-y-4">
          <h3 class="text-lg font-semibold text-gray-800 border-b border-gray-200 pb-2">Medical Information</h3>
          
          <div class="space-y-2">
            <label class="text-sm font-medium text-gray-700" for="weight">Weight (kg) *</label>
            <input 
              type="number" 
              id="weight" 
              name="weight"
              min="50"
              max="200"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 outline-none transition-all duration-200"
              placeholder="Enter your weight in kg (minimum 50kg)"
              required
            />
            <p class="text-xs text-gray-500">Minimum weight required for donation is 50kg</p>
          </div>

          <div class="space-y-3">
            <p class="text-sm font-medium text-gray-700">Medical History</p>
            
            <label class="flex items-start space-x-3 cursor-pointer group">
              <input type="checkbox" name="conditions" value="chronic" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
              <span class="text-sm text-gray-600 group-hover:text-gray-900">I have a chronic medical condition (diabetes, hypertension, etc.)</span>
            </label>
            
            <label class="flex items-start space-x-3 cursor-pointer group">
              <input type="checkbox" name="conditions" value="medications" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
              <span class="text-sm text-gray-600 group-hover:text-gray-900">I am currently taking long-term medication</span>
            </label>
            
            <label class="flex items-start space-x-3 cursor-pointer group">
              <input type="checkbox" name="conditions" value="pregnant" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
              <span class="text-sm text-gray-600 group-hover:text-gray-900">I am pregnant or breastfeeding</span>
            </label>
            
            <label class="flex items-start space-x-3 cursor-pointer group">
              <input type="checkbox" name="conditions" value="recentSurgery" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
              <span class="text-sm text-gray-600 group-hover:text-gray-900">I have had surgery in the last 6 months</span>
            </label>
            
            <label class="flex items-start space-x-3 cursor-pointer group">
              <input type="checkbox" name="conditions" value="tattoo" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
              <span class="text-sm text-gray-600 group-hover:text-gray-900">I have received a tattoo or piercing in the last 6 months</span>
            </label>
          </div>
        </div>

        <!-- Consent and Agreement -->
        <div class="space-y-4 bg-gray-50 p-6 rounded-xl">
          <h3 class="text-lg font-semibold text-gray-800">Consent and Agreement</h3>
          
          <label class="flex items-start space-x-3 cursor-pointer group">
            <input type="checkbox" name="consent" value="terms" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" required />
            <span class="text-sm text-gray-600 group-hover:text-gray-900">
              I confirm that the information provided is true and accurate. I understand that false information may disqualify me from donating blood.
            </span>
          </label>
          
          <label class="flex items-start space-x-3 cursor-pointer group">
            <input type="checkbox" name="consent" value="contact" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" required />
            <span class="text-sm text-gray-600 group-hover:text-gray-900">
              I agree to be contacted by SangRoot and partner hospitals regarding blood donation opportunities.
            </span>
          </label>
          
          <label class="flex items-start space-x-3 cursor-pointer group">
            <input type="checkbox" name="consent" value="privacy" class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" required />
            <span class="text-sm text-gray-600 group-hover:text-gray-900">
              I have read and agree to the <a href="/privacy" class="text-orange-500 hover:underline">Privacy Policy</a> and <a href="/terms" class="text-orange-500 hover:underline">Terms of Service</a>.
            </span>
          </label>
        </div>

        <!-- Submit Button - Changed to orange -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <button 
            type="submit" 
            class="flex-1 bg-gradient-to-r from-orange-500 to-orange-400 text-white px-8 py-4 rounded-lg font-semibold hover:shadow-lg hover:scale-105 active:scale-95 transition-all duration-300 group"
          >
            <span class="flex items-center justify-center">
              Register as Donor
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </span>
          </button>
          
          <button 
            type="reset" 
            class="flex-1 bg-gray-100 text-gray-700 px-8 py-4 rounded-lg font-semibold hover:bg-gray-200 hover:scale-105 active:scale-95 transition-all duration-300"
          >
            Clear Form
          </button>
        </div>

        <!-- Success Message (hidden by default) -->
        <div id="successMessage" class="hidden mt-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg animate-fade-in-up">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Thank you for registering! A confirmation email has been sent to your email address.</span>
          </div>
        </div>
      </form>
    </div>

    <!-- Additional Information -->
    <div class="max-w-3xl mx-auto mt-12 text-center animate-fade-in-up animation-delay-600">
      <div class="bg-white/50 backdrop-blur-sm rounded-xl p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-2">Donation Requirements</h3>
        <p class="text-sm text-gray-600 mb-4">
          To be eligible for blood donation, you must:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-left">
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">Be between 18-65 years old</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">Weigh at least 50kg</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">Be in good health</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">No recent infections/illnesses</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">Not pregnant/breastfeeding</span>
          </div>
          <div class="flex items-start space-x-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm text-gray-600">No risky behaviors</span>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Animation Classes */
  @keyframes fadeInDown { 
    from {opacity:0;transform:translateY(-30px)} 
    to {opacity:1;transform:translateY(0)} 
  }
  
  @keyframes fadeInUp { 
    from {opacity:0;transform:translateY(30px)} 
    to {opacity:1;transform:translateY(0)} 
  }
  
  @keyframes bounceIn { 
    0%{opacity:0;transform:scale(.3)}
    50%{opacity:1;transform:scale(1.05)}
    70%{transform:scale(.9)}
    100%{transform:scale(1)} 
  }

  .animate-fade-in-down{animation:fadeInDown .8s ease-out forwards}
  .animate-fade-in-up{animation:fadeInUp .8s ease-out forwards}
  .animate-bounce-in{animation:bounceIn .8s cubic-bezier(.68,-.55,.265,1.55) forwards}

  /* Animation Delays */
  .animation-delay-200{animation-delay:.2s}
  .animation-delay-400{animation-delay:.4s}
  .animation-delay-600{animation-delay:.6s}

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-down,
    .animate-fade-in-up,
    .animate-bounce-in,
    .hover\:scale-105:hover,
    .hover\:shadow-xl:hover,
    .group-hover\:translate-x-1:hover,
    .group-hover\:scale-110:hover {
      animation: none !important;
      transform: none !important;
      transition: none !important;
    }
    
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // Form submission handler
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('donorRegistrationForm');
    const successMessage = document.getElementById('successMessage');
    
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Here you would typically send the data to your backend
        // For now, we'll just show the success message
        
        // Hide success message if already visible
        if (successMessage) {
          successMessage.classList.remove('hidden');
          
          // Scroll to success message
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
          
          // Optionally reset form after 3 seconds
          setTimeout(() => {
            form.reset();
            successMessage.classList.add('hidden');
          }, 5000);
        }
        
        console.log('Form submitted:', new FormData(form));
      });
    }
  });
</script>