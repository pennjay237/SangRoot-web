---
const features = [
  {
    icon: '⚡',
    title: 'Emergency-First Design',
    description: 'Built specifically for critical situations where every minute counts. Automated workflows reduce coordination time from hours to minutes.',
  },
  {
    icon: '🤖',
    title: 'AI-Powered Messaging',
    description: 'Intelligent agents conduct natural conversations with donors via WhatsApp/SMS, handling availability checks and scheduling automatically.',
  },
  {
    icon: '🔒',
    title: 'Privacy Protected',
    description: 'Donor identities remain anonymous. Doctors receive only aggregate summaries—no personal information or phone numbers exposed.',
  },
  {
    icon: '🏥',
    title: 'Hospital Authority',
    description: 'All requests originate from verified hospitals. Only approved institutions and doctors can access the platform.',
  },
  {
    icon: '📱',
    title: 'Low-Bandwidth Compatible',
    description: 'Works with SMS and basic WhatsApp—no smartphone or internet required for donors to participate.',
  },
  {
    icon: '✅',
    title: 'Complete Audit Trail',
    description: 'Every action logged and timestamped. Full compliance with medical regulations and consent requirements.',
  },
];
---

<section class="section-padding bg-gray-50">
  <div class="section-container">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-block bg-primary-100 text-primary-700 px-4 py-2 rounded-full text-sm font-semibold mb-4">
        Platform Features
      </div>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-6">
        Why Choose SangRoot?
      </h2>
      <p class="text-lg text-gray-600">
        A comprehensive platform designed for emergency blood coordination in Cameroon
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="text-5xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-heading font-bold text-gray-900 mb-3">
            {feature.title}
          </h3>
          <p class="text-gray-600 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Stats Section -->
    <div class="mt-20 bg-gradient-to-r from-primary-500 to-primary-600 rounded-2xl p-8 md:p-12 text-white">
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2">24/7</div>
          <div class="text-primary-100">Always Available</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2">&lt;15min</div>
          <div class="text-primary-100">Average Response Time</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-bold mb-2">100%</div>
          <div class="text-primary-100">Privacy Protected</div>
        </div>
      </div>
    </div>
  </div>
</section>