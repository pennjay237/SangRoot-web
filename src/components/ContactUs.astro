<section id="contact" class="section-padding bg-white">
  <div class="section-container">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Left Content -->
      <div>
        <div class="inline-block bg-primary-100 text-primary-700 px-4 py-2 rounded-full text-sm font-semibold mb-4">
          Get In Touch
        </div>
        
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-6">
          Contact Us
        </h2>
        
        <p class="text-lg text-gray-600 mb-8">
          Have questions about SangRoot? Want to register your hospital or blood bank? 
          We'd love to hear from you.
        </p>

        <!-- Contact Info -->
        <div class="space-y-6">
          <div class="flex items-start gap-4 hover:translate-x-2 transition-transform duration-300">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Email</h3>
              <a href="mailto:contact@sangroot.cm" class="text-primary-500 hover:text-primary-600 hover:underline transition-all duration-300">
                contact@sangroot.cm
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 hover:translate-x-2 transition-transform duration-300">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Phone</h3>
              <a href="tel:+237123456789" class="text-primary-500 hover:text-primary-600 hover:underline transition-all duration-300">
                +237 123 456 789
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 hover:translate-x-2 transition-transform duration-300">
            <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-1">Location</h3>
              <p class="text-gray-600">Yaoundé, Cameroon</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Form -->
      <div class="bg-gray-50 rounded-2xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-500">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
              Full Name *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-300 hover:border-primary-300 focus:scale-[1.02]"
              placeholder="John Doe"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-300 hover:border-primary-300 focus:scale-[1.02]"
              placeholder="john@example.com"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
              Phone Number *
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-300 hover:border-primary-300 focus:scale-[1.02]"
              placeholder="+237 123 456 789"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
              Message *
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-300 resize-none hover:border-primary-300 focus:scale-[1.02]"
              placeholder="How can we help you?"
            ></textarea>
          </div>

          <button type="submit" class="w-full btn-primary text-lg hover:scale-105 active:scale-95 transition-transform duration-200">
            Send Message
          </button>

          <div id="form-message" class="hidden p-4 rounded-lg"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animation Definitions */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulseSoft {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /* Animation Classes */
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .animate-fade-in-down {
    animation: fadeInDown 0.6s ease-out forwards;
  }

  .animate-slide-in-left {
    animation: slideInLeft 1s ease-out forwards;
  }

  .animate-slide-in-right {
    animation: slideInRight 1s ease-out forwards;
  }

  .animate-slide-down {
    animation: slideDown 0.4s ease-out forwards;
  }

  .animate-pulse-soft {
    animation: pulseSoft 3s ease-in-out infinite;
  }

  /* Animation Delays */
  .animation-delay-100 {
    animation-delay: 0.1s;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-300 {
    animation-delay: 0.3s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-500 {
    animation-delay: 0.5s;
  }

  /* Helper class to reset animations */
  .animation-reset {
    animation: none !important;
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up,
    .animate-fade-in-down,
    .animate-slide-in-left,
    .animate-slide-in-right,
    .animate-slide-down,
    .animate-pulse-soft {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // Form submission handler
  const form = document.getElementById('contact-form');
  const formMessage = document.getElementById('form-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        // Simulate API call
        await new Promise(resolve => setTimeout(resolve, 1000));
        
        // Show success message
        formMessage.textContent = 'Thank you! Your message has been sent successfully.';
        formMessage.className = 'p-4 rounded-lg bg-secondary-100 text-secondary-800 animate-slide-down';
        formMessage.classList.remove('hidden');
        
        // Reset form
        form.reset();
        
        // Hide message after 5 seconds
        setTimeout(() => {
          formMessage.classList.add('hidden');
        }, 5000);
        
      } catch (error) {
        // Show error message
        formMessage.textContent = 'Sorry, something went wrong. Please try again.';
        formMessage.className = 'p-4 rounded-lg bg-primary-100 text-primary-800 animate-slide-down';
        formMessage.classList.remove('hidden');
      }
    });
  }

  // Animation Manager for the contact section
  document.addEventListener('DOMContentLoaded', function() {
    const contactSection = document.getElementById('contact');
    
    if (!contactSection) return;
    
    // Get all animated elements in contact section
    const contactElements = contactSection.querySelectorAll(
      '.inline-block.bg-primary-100, ' + // "Get In Touch" badge
      'h2.font-heading, ' + // "Contact Us" heading
      '.text-lg.text-gray-600.mb-8, ' + // Description paragraph
      '.space-y-6 > div:nth-child(1), ' + // Email contact card
      '.space-y-6 > div:nth-child(2), ' + // Phone contact card  
      '.space-y-6 > div:nth-child(3), ' + // Location contact card
      '.bg-gray-50.rounded-2xl' // Form container
    );
    
    // Get form elements
    const formElements = contactSection.querySelectorAll(
      '#contact-form > div, #contact-form > button'
    );
    
    // Get contact info icons
    const contactIcons = contactSection.querySelectorAll('.w-12.h-12.bg-primary-100');
    
    // Function to apply animations to all elements
    function applyContactAnimations() {
      // Reset all animations first
      contactElements.forEach(el => {
        el.classList.add('animation-reset');
      });
      formElements.forEach(el => {
        el.classList.add('animation-reset');
      });
      contactIcons.forEach(el => {
        el.classList.add('animation-reset');
      });
      
      // Trigger reflow to reset animations
      void contactSection.offsetWidth;
      
      // Remove reset classes
      contactElements.forEach(el => {
        el.classList.remove('animation-reset');
      });
      formElements.forEach(el => {
        el.classList.remove('animation-reset');
      });
      contactIcons.forEach(el => {
        el.classList.remove('animation-reset');
      });
      
      // Apply staggered animations to left content
      const leftContentElements = [
        contactSection.querySelector('.inline-block.bg-primary-100'), // Badge
        contactSection.querySelector('h2.font-heading'), // Heading
        contactSection.querySelector('.text-lg.text-gray-600.mb-8'), // Description
        contactSection.querySelector('.space-y-6 > div:nth-child(1)'), // Email
        contactSection.querySelector('.space-y-6 > div:nth-child(2)'), // Phone
        contactSection.querySelector('.space-y-6 > div:nth-child(3)') // Location
      ];
      
      leftContentElements.forEach((el, index) => {
        if (el) {
          if (index === 0) {
            el.classList.add('animate-fade-in-down');
          } else if (index >= 3) {
            // Contact cards get slide-in-left with delays
            el.classList.add('animate-slide-in-left');
            el.classList.add(`animation-delay-${(index - 2) * 100}`);
          } else {
            // Heading and description get fade-in-up with delays
            el.classList.add('animate-fade-in-up');
            el.classList.add(`animation-delay-${index * 100}`);
          }
        }
      });
      
      // Apply pulse animation to icons
      contactIcons.forEach((icon, index) => {
        if (icon) {
          icon.classList.add('animate-pulse-soft');
          icon.classList.add(`animation-delay-${index * 100}`);
        }
      });
      
      // Apply animations to form container and elements
      const formContainer = contactSection.querySelector('.bg-gray-50.rounded-2xl');
      if (formContainer) {
        formContainer.classList.add('animate-slide-in-right');
      }
      
      // Apply staggered animations to form elements
      formElements.forEach((el, index) => {
        el.classList.add('animate-fade-in-up');
        el.classList.add(`animation-delay-${(index + 1) * 100}`);
      });
      
      console.log('Contact animations applied!');
    }
    
    // Function to check if element is in viewport
    function isElementInViewport(el) {
      const rect = el.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;
      
      return (
        rect.top <= windowHeight * 0.8 &&
        rect.bottom >= windowHeight * 0.2
      );
    }
    
    // Initial animation state
    let contactAnimationsPlayed = false;
    
    // Play animations when section comes into view
    function playContactAnimationsOnScroll() {
      if (!contactAnimationsPlayed && isElementInViewport(contactSection)) {
        applyContactAnimations();
        contactAnimationsPlayed = true;
      }
    }
    
    // Listen for hash change (when navbar link is clicked)
    window.addEventListener('hashchange', function() {
      if (window.location.hash === '#contact') {
        // Small delay to ensure scroll completes
        setTimeout(() => {
          applyContactAnimations();
          contactAnimationsPlayed = true;
        }, 300);
      }
    });
    
    // Listen for click events on navbar links
    document.addEventListener('click', function(e) {
      const link = e.target.closest('a[href="#contact"]');
      if (link) {
        e.preventDefault();
        
        // Scroll to section
        contactSection.scrollIntoView({ behavior: 'smooth' });
        
        // Play animations after scroll
        setTimeout(() => {
          applyContactAnimations();
          contactAnimationsPlayed = true;
        }, 500);
      }
    });
    
    // Set up Intersection Observer
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !contactAnimationsPlayed) {
            applyContactAnimations();
            contactAnimationsPlayed = true;
          }
        });
      }, {
        threshold: 0.3,
        rootMargin: '0px 0px -50px 0px'
      });
      
      observer.observe(contactSection);
    } else {
      // Fallback for older browsers
      window.addEventListener('scroll', playContactAnimationsOnScroll);
      window.addEventListener('resize', playContactAnimationsOnScroll);
    }
    
    // Initial check
    setTimeout(() => {
      if (isElementInViewport(contactSection)) {
        applyContactAnimations();
        contactAnimationsPlayed = true;
      }
    }, 100);
    
    // Also play animations if user is already on #contact page
    if (window.location.hash === '#contact') {
      setTimeout(() => {
        applyContactAnimations();
        contactAnimationsPlayed = true;
      }, 500);
    }
  });
</script>